[Unit]
Description=Karakos scheduler (cron-style task dispatch)
After=network-online.target karakos-agent-server.service
Wants=network-online.target
# Requires=, not BindsTo= (changed 2026-08-18) — see karakos-relay.service
# for the full incident writeup. Same bug, same fix: BindsTo= forcibly
# stopped this unit on every agent-server bounce and never restarted it,
# leaving it dead for ~9h after the 09:34 restart-server test until
# manually started.
# Wants=, not Requires= (changed 2026-10-01): Requires= still propagates
# restarts. When agent-server exits and systemd relaunches it, this unit
# gets stopped and restarted alongside it. For relay that killed
# /restart-server's own handler mid-poll, so the Discord interaction sat on
# "thinking..." forever (every run since 09-15 ends at "polling for new
# boot_id", never "new boot_id seen"). Wants= keeps the start ordering
# (via After=) without tying this unit's lifetime to agent-server's.
Wants=karakos-agent-server.service

[Service]
Type=simple
User=karakos
Group=karakos

WorkingDirectory=/opt/karakos
Environment=HOME=/home/karakos
Environment=WORKSPACE_ROOT=/opt/karakos
EnvironmentFile=/opt/karakos/config/.env

ExecStart=/opt/karakos/.venv/bin/python3 /opt/karakos/bin/scheduler.py

Restart=always
RestartSec=2
RestartSteps=8
RestartMaxDelaySec=300

# Matches supervisord.conf's stopwaitsecs=5 for [program:scheduler].
TimeoutStopSec=5
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=karakos-scheduler

[Install]
WantedBy=multi-user.target
