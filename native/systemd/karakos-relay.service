[Unit]
Description=Karakos relay (Discord I/O)
After=network-online.target karakos-agent-server.service
Wants=network-online.target
# Requires=, not BindsTo= (changed 2026-08-18): BindsTo= propagates STOPS
# too, not just start ordering — any agent-server bounce (including the
# designed /sys restart-server path) forcibly stopped this unit as a
# side effect, and nothing brings it back afterward (a systemd-issued
# stop from a dependency chain doesn't trigger Restart=always the way a
# crash would). Real incident: the 09:34 restart-server test bounced
# agent-server cleanly in ~2s as designed, but relay and scheduler both
# got yanked down with it and sat dead for ~9h until manually started.
# relay already tolerates agent-server being briefly unreachable (durable
# outbox queue, retry spooling) — it doesn't need to die with it.
# Wants=, not Requires= (changed 2026-10-01): Requires= still propagates
# restarts. When agent-server exits and systemd relaunches it, this unit
# gets stopped and restarted alongside it. For relay that killed
# /restart-server's own handler mid-poll, so the Discord interaction sat on
# "thinking..." forever (every run since 09-15 ends at "polling for new
# boot_id", never "new boot_id seen"). Wants= keeps the start ordering
# (via After=) without tying this unit's lifetime to agent-server's.
Wants=karakos-agent-server.service

[Service]
Type=simple
User=karakos
Group=karakos

WorkingDirectory=/opt/karakos
Environment=HOME=/home/karakos
Environment=WORKSPACE_ROOT=/opt/karakos
EnvironmentFile=/opt/karakos/config/.env

ExecStart=/opt/karakos/.venv/bin/python3 /opt/karakos/bin/relay.py

# Amos's correction (2026-08-10): on-failure is wrong here. A clean Discord
# gateway close / main() falling off the end is exit 0 — on-failure would
# leave the unit dead with no restart and no failure signal. The container's
# supervisord autorestart=true has the same "restart regardless of exit
# reason" semantics; Restart=always is the faithful port of that.
Restart=always
RestartSec=2
RestartSteps=8
RestartMaxDelaySec=300

# Matches supervisord.conf's stopwaitsecs=10 for [program:relay].
TimeoutStopSec=10
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=karakos-relay

[Install]
WantedBy=multi-user.target
