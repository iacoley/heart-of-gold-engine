# Secrets — never commit real credentials
config/.env

# Runtime state and data — not source, regenerated/accumulated at runtime
data/
logs/

# Local install metadata (owner name, install timestamp) — not for a shared repo
.karakos/

# Claude Code's own local session state
.claude/

# Node
dashboard/node_modules/
dashboard/.next/
dashboard/tsconfig.tsbuildinfo
mcp/browser/node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/

# External reference clones — synced separately, not vendored into our history
external/

# OS cruft
.DS_Store
